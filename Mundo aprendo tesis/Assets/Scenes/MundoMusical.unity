  m_Script: {fileID: 11500000, guid: 850b76e570a3d82458be09a5f9005319, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Bolin.MusicalTutorialController
  overlayGroup: {fileID: 85221951}
  gameplayGroup: {fileID: 1460664893}
  characterRoot: {fileID: 1941874402}
  characterImage: {fileID: 1941874403}
  tutorialText: {fileID: 497909311}
  stepCounterText: {fileID: 1585380253}
  nextButton: {fileID: 300838774}
  startButton: {fileID: 1650732696}
  tutorialSteps:
  - text: "\xA1Hola! Soy Tamborcin. Vamos a tocar una melod\xEDa."
    characterPose: {fileID: 21300000, guid: b857d3c2ca52c5f44bf191ed37cd6594, type: 3}
  - text: Primero escucha y observa las teclas que se iluminan.
    characterPose: {fileID: 21300000, guid: df56e56a7f5015c4e8ee23bb6f94c720, type: 3}
  - text: "Despu\xE9s, toca las mismas teclas en el mismo orden."
    characterPose: {fileID: 21300000, guid: b857d3c2ca52c5f44bf191ed37cd6594, type: 3}
  - text: "Escucha con atenci\xF3n y recuerda la secuencia."
    characterPose: {fileID: 21300000, guid: df56e56a7f5015c4e8ee23bb6f94c720, type: 3}
  - text: "\xA1Listo! Presiona Comenzar para tocar."
    characterPose: {fileID: 21300000, guid: 4f83b8030f0a2ef4688c14136356dbcb, type: 3}
  fadeDuration: 0.24
