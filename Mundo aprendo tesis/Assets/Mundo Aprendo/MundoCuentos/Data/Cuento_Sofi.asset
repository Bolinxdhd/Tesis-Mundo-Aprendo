  m_Script: {fileID: 11500000, guid: 3ba8b7374b517f94d83dee2b68b16318, type: 3}
  m_Name: Cuento_Sofi
  m_EditorClassIdentifier: Assembly-CSharp::Bolin.CuentoData
  id: sofi
  titulo: "Sofi, la ardilla que cuid\xF3 el bosque"
  portada: {fileID: 21300000, guid: 79a96c856f3e60a42b925f069ea674e9, type: 3}
  narracionTexto: "Sofi viv\xEDa en un bosque lleno de hojas verdes. Un d\xEDa encontr\xF3
    basura tirada: papeles, latas y una botella. Ella no sab\xEDa qui\xE9n lo hizo,
    pero s\xED sab\xEDa que el bosque era su hogar. Llam\xF3 a sus amigos Loro, Tortuga
    y Conejo, y juntos recogieron todo. Cuando terminaron, el bosque volvi\xF3 a
    brillar. Sofi dijo: \u201CCuidar lo que es nuestro es cuidar de nosotros mismos\u201D.
    Desde entonces, todos ense\xF1aban a los dem\xE1s a mantener el bosque limpio."
  narracionAudio: {fileID: 0}
