  m_Script: {fileID: 11500000, guid: 3ba8b7374b517f94d83dee2b68b16318, type: 3}
  m_Name: Cuento_Tito
  m_EditorClassIdentifier: Assembly-CSharp::Bolin.CuentoData
  id: tito
  titulo: "Tito, el osito que aprendi\xF3 a escuchar"
  portada: {fileID: 21300000, guid: ab81bf4b90357b143af1073043a5652a, type: 3}
  narracionTexto: "Tito era un osito muy alegre, pero hablaba tanto que casi nunca
    escuchaba a los dem\xE1s. Un d\xEDa, en el bosque, sus amigos ardilla y zorro
    quer\xEDan contarle algo importante: hab\xEDan encontrado un lago nuevo para
    jugar. Pero Tito hablaba y hablaba sin parar. De pronto, se dio cuenta de que
    ellos estaban en silencio, esperando. Tito respir\xF3 hondo, escuch\xF3 y se
    enter\xF3 de todo. Cuando llegaron al lago, Tito dijo: \u201CEscuchar me ayuda
    a no perderme cosas lindas\u201D."
  narracionAudio: {fileID: 0}
  pictogramas:
  - id: osito
    imagen: {fileID: 21300000, guid: ab81bf4b90357b143af1073043a5652a, type: 3}
    concepto: osito
    respuestasAceptadas:
    - osito
    - oso
    - tito
    ayuda: "Es un oso peque\xF1o. Empieza con O\u2026"
    preguntaAudio: {fileID: 0}
    feedbackCorrecto: {fileID: 0}
  - id: ardilla
    imagen: {fileID: 21300000, guid: 3dfcecae191c33a489cff5b7d3409530, type: 3}
    concepto: ardilla
    respuestasAceptadas:
    - ardilla
    ayuda: "Tiene una cola grande. Empieza con AR\u2026"
    preguntaAudio: {fileID: 0}
    feedbackCorrecto: {fileID: 0}
  - id: zorro
    imagen: {fileID: 21300000, guid: 340f7018c0303744fb7c2c0c1da1dcc7, type: 3}
    concepto: zorro
    respuestasAceptadas:
    - zorro
    ayuda: "Es un animal del bosque. Empieza con ZO\u2026"
    preguntaAudio: {fileID: 0}
    feedbackCorrecto: {fileID: 0}
  - id: bosque
