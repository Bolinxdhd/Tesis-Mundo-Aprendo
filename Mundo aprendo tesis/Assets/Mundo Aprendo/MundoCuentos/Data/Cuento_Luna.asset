  m_Script: {fileID: 11500000, guid: 3ba8b7374b517f94d83dee2b68b16318, type: 3}
  m_Name: Cuento_Luna
  m_EditorClassIdentifier: Assembly-CSharp::Bolin.CuentoData
  id: luna
  titulo: "Luna, la coneja que compart\xEDa su zanahoria"
  portada: {fileID: 21300000, guid: b5b58c3fd721c0d4a9616c99712720a3, type: 3}
  narracionTexto: "Luna era una coneja blanca que ten\xEDa una zanahoria muy grande
    y muy anaranjada. La cuidaba todos los d\xEDas y la llevaba a todas partes. Un
    d\xEDa, encontr\xF3 a su amigo Rat\xF3n, que estaba triste porque no hab\xEDa
    encontrado comida. Luna mir\xF3 su zanahoria, pens\xF3 un momento y decidi\xF3
    partirla en dos. Rat\xF3n sonri\xF3 y juntos comieron felices bajo un \xE1rbol.
    Esa tarde, Luna descubri\xF3 que compartir hac\xEDa la comida m\xE1s dulce y
    el d\xEDa m\xE1s bonito."
  narracionAudio: {fileID: 0}
  pictogramas:
  - id: coneja
    imagen: {fileID: 21300000, guid: b5b58c3fd721c0d4a9616c99712720a3, type: 3}
    concepto: coneja
    respuestasAceptadas:
    - coneja
    - conejita
    - luna
    ayuda: "Es una conejita. Empieza con CO\u2026"
    preguntaAudio: {fileID: 0}
    feedbackCorrecto: {fileID: 0}
  - id: zanahoria
