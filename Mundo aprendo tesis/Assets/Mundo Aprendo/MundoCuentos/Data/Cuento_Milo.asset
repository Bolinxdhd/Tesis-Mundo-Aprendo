    respuestasAceptadas:
    - rana
    ayuda: "Es verde y salta. Empieza con RA\u2026"
    preguntaAudio: {fileID: 0}
    feedbackCorrecto: {fileID: 0}
  - id: arbustos
    imagen: {fileID: 21300000, guid: 6325631e3c0e31c408fd38f8564ee9e2, type: 3}
    concepto: arbustos
    respuestasAceptadas:
    - arbustos
    - arbusto
    ayuda: "Son plantas m\xE1s peque\xF1as que los \xE1rboles. Empieza con AR\u2026"
    preguntaAudio: {fileID: 0}
    feedbackCorrecto: {fileID: 0}
  - id: huellas
