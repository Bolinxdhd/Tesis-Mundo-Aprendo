  m_Script: {fileID: 11500000, guid: f6386ea2e78b7984383aa76154d32c72, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Bolin.StoryTutorialAnimationController
  overlayGroup: {fileID: 742715714}
  inputBlockerGroup: {fileID: 2044548885}
  darkBackground: {fileID: 1232998506}
  guideCharacter: {fileID: 1785197939}
  guideCharacterImage: {fileID: 1785197941}
  dialoguePanel: {fileID: 1815840026}
  tutorialText: {fileID: 1451235112}
  stepCounterText: {fileID: 1517682387}
  stepIconImage: {fileID: 0}
  previousButton: {fileID: 631537614}
  nextButton: {fileID: 740563875}
  finishButton: {fileID: 486459355}
  skipButton: {fileID: 1532168389}
  skipConfirmationRoot: {fileID: 1766491694}
  skipConfirmationGroup: {fileID: 1766491696}
  confirmSkipButton: {fileID: 298287844}
  cancelSkipButton: {fileID: 1688547577}
  tutorialSteps:
  - text: "\xA1Hola! Soy Biblio. Aqu\xED vamos a escuchar cuentos y descubrir pictogramas."
    biblioSprite: {fileID: 21300000, guid: b4052b5b76539a24cbb3b94a3a351825, type: 3}
    dialogueAnchoredPosition: {x: 210, y: 401}
    minimumVisibleSeconds: 0
    iconSprite: {fileID: 0}
  - text: Elige uno de estos libros para comenzar. Los cuentos se desbloquean en
      orden.
    biblioSprite: {fileID: 21300000, guid: b4052b5b76539a24cbb3b94a3a351825, type: 3}
    dialogueAnchoredPosition: {x: 210, y: 401}
    minimumVisibleSeconds: 0
    iconSprite: {fileID: 0}
  - text: "Observa cada pictograma y escucha la pregunta. El micr\xF3fono se encender\xE1
      despu\xE9s."
    biblioSprite: {fileID: 21300000, guid: b4052b5b76539a24cbb3b94a3a351825, type: 3}
    dialogueAnchoredPosition: {x: 210, y: 401}
    minimumVisibleSeconds: 0
    iconSprite: {fileID: 0}
  - text: "Di el concepto que ves. Tambi\xE9n puedes responder con una frase, por
      ejemplo: yo veo una zanahoria."
    biblioSprite: {fileID: 21300000, guid: b4052b5b76539a24cbb3b94a3a351825, type: 3}
    dialogueAnchoredPosition: {x: 210, y: 401}
    minimumVisibleSeconds: 0
    iconSprite: {fileID: 0}
  - text: "Si necesitas ayuda, Biblio te dar\xE1 pistas. \xA1Completa todos los pictogramas
      para ganar estrellas!"
    biblioSprite: {fileID: 21300000, guid: 9e13a4da03fb0b94cba9ce140540cf86, type: 3}
    dialogueAnchoredPosition: {x: 210, y: 401}
    minimumVisibleSeconds: 0
    iconSprite: {fileID: 0}
  typewriterCharactersPerSecond: 42
  characterEntryDistance: 120
  entryDuration: 0.28
  waveDegrees: 4
