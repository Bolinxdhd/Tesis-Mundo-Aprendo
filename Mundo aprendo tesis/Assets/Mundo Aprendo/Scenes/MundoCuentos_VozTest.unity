  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Hab\xEDa una vez tres cerditos que viv\xEDan cerca del bosque. Cada uno
    construy\xF3 una casa para protegerse del lobo. El primer cerdito hizo una casa
    de paja, el segundo una casa de madera y el tercero una casa de ladrillos. Cuando
    lleg\xF3 el lobo, solo la casa de ladrillos permaneci\xF3 firme. Los tres cerditos
    entraron en ella y estuvieron seguros."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
